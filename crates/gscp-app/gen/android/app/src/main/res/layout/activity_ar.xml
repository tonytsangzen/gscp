<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 连接设置 -->
    <LinearLayout
        android:id="@+id/settings_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="AR 试验模式"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:text="仅拉取 overlay 画面，用手机摄像头追踪人脸，\n把 overlay 绘制在人脸正前方（试验性）"
            android:textColor="#99FFFFFF"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/ip_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="眼镜 IP 地址"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#66FFFFFF" />

        <Button
            android:id="@+id/button_connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="连接" />

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- AR 画面：SurfaceView，相机帧 + 检测/姿态/overlay 全部画在同一 Canvas 上
         （与 ncnn-benchmark CameraActivity 同架构：所见即所测） -->
    <FrameLayout
        android:id="@+id/ar_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <android.view.SurfaceView
            android:id="@+id/ar_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/ar_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="32dp"
            android:background="#66000000"
            android:padding="8dp"
            android:text="等待人脸…"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 后摄模式 GL 合成输出面：眼镜视频+overlay 由 SurfaceMixer(GLES2) 直出，
         盖在 ar_surface 之上；仅后摄可见（前摄走 ar_surface 的 Canvas 人脸 AR） -->
    <android.view.SurfaceView
        android:id="@+id/ar_gl_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 底部相机 App 控制条：左=最近录像，中=录像，右=前后摄切换（随录像按钮一起显示/隐藏） -->
    <LinearLayout
        android:id="@+id/bottom_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/last_thumb"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="54dp"
            android:background="@drawable/bg_thumb"
            android:contentDescription="最近录像"
            android:foreground="@drawable/bg_thumb_ring"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_gallery" />

        <ImageButton
            android:id="@+id/button_record"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/ic_record_idle"
            android:contentDescription="录像"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/btn_switch_cam"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="54dp"
            android:background="@drawable/bg_switch_btn"
            android:contentDescription="切换前后摄"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_cam_flip" />
    </LinearLayout>

    <!-- 录像启动/停止中的忙碌指示：与录像按钮同圆心、同外径的旋转进度环（叠加在按钮上） -->
    <com.gscp.desktop.RingSpinner
        android:id="@+id/record_spinner"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="44dp"
        android:visibility="gone" />

    <!-- 顶部状态 overlay：录像中→闪烁红点+时长(常驻)；空闲→信息文字 5s 后隐藏 -->
    <TextView
        android:id="@+id/rec_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="44dp"
        android:background="#80000000"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:typeface="monospace"
        android:visibility="gone" />
</FrameLayout>
